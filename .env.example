# Redshift connection details
REDSHIFT_HOST=your-cluster.region.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=your_database
REDSHIFT_USER=your_username
REDSHIFT_PASSWORD=your_password

# Optional: comma-separated schemas list_tables uses when the caller names none.
# Leave blank (or set to "all" or "*") to use every schema.
REDSHIFT_SCHEMAS=

# Optional: the hostname to verify the TLS certificate against. Only needed if
# you connect through a DNS alias (CNAME) that does not resolve to a
# *.redshift.amazonaws.com name. By default the alias is followed automatically.
# REDSHIFT_CERT_HOST=your-cluster.xxxxxxxx.region.redshift.amazonaws.com

# Optional: extra guidance appended to the server instructions the model sees,
# for example naming conventions, preferred views or sensitive schemas.
# REDSHIFT_EXTRA_INSTRUCTIONS=Prefer the reporting.* views. Never query the hr schema.

# Transport configuration
TRANSPORT_TYPE=stdio  # or 'sse'. Tests use stdio.
PORT=3000            # Only used with SSE transport
